rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to verify user ownership
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Role-Based Access Control helper
    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'VIEWER';
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'ADMIN';
    }

    function isOperator() {
      return isAuthenticated() && (getUserRole() == 'OPERATOR' || getUserRole() == 'ADMIN');
    }

    function isAnalyst() {
      return isAuthenticated() && (getUserRole() == 'ANALYST' || getUserRole() == 'OPERATOR' || getUserRole() == 'ADMIN');
    }

    // User profile document & private tactical logs
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.role == 'VIEWER';
      allow update: if isAdmin()
        || (isOwner(userId) && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();

      // Subcollection for tactical logs, voice transcriptions, and geo-grounded reports
      match /tactical_logs/{logId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Operational Incidents collection (Single Canonical Source of Truth)
    match /incidents/{incidentId} {
      allow read: if isAuthenticated();
      allow create: if isOperator()
        && request.resource.data.title is string
        && request.resource.data.severity is string
        && request.resource.data.status == 'REPORTED'
        && request.resource.data.verificationStatus == 'AWAITING_VERIFICATION'
        && request.resource.data.coordinates.lat is number
        && request.resource.data.coordinates.lng is number;
      allow update: if (isOperator() || isAnalyst())
        && request.resource.data.status != 'VERIFIED'
        && request.resource.data.verificationStatus == resource.data.verificationStatus;
      allow delete: if isAdmin();
    }

    // Tactical Alerts collection (correlated via relatedEventId)
    match /alerts/{alertId} {
      allow read: if isAuthenticated();
      allow write: if isOperator();
    }

    // Hazard Zones collection
    match /hazard_zones/{zoneId} {
      allow read: if isAuthenticated();
      allow write: if isOperator();
    }

    // Carrying Capacity Assessments
    match /carrying_capacity/{zoneId} {
      allow read: if isAuthenticated();
      allow write: if isOperator();
    }

    // Relocation Plans
    match /relocation_plans/{zoneId} {
      allow read: if isAuthenticated();
      allow write: if isOperator();
    }

    // Evidence and Satellite Ingestions
    match /evidence/{evidenceId} {
      allow read: if isAuthenticated();
      allow write: if isAnalyst();
    }

    // Chronological Timelines (correlated via relatedZoneId)
    match /timelines/{timelineId} {
      allow read: if isAuthenticated();
      allow write: if isOperator();
    }

    // Broadcast Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow write: if isOperator();
    }

    // Workspace response resources
    match /resources/{resourceId} {
      allow read: if isAuthenticated();
      allow write: if isOperator();
    }

    // Connection testing endpoint (read-only verification for boot connection handshake)
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Catch-all safety default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
